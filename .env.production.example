# ── App ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Frontend URL (used for CORS and email links)
APP_URL=https://erp.yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=https://erp.yourdomain.com

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://erpuser:STRONG_PASSWORD_HERE@localhost:5434/erpdb

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=STRONG_REDIS_PASSWORD_HERE

# ── JWT ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_DAYS=30

# ── M-Pesa (Safaricom Daraja — PRODUCTION) ───────────────────
MPESA_BASE_URL=https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=YOUR_PRODUCTION_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_PRODUCTION_CONSUMER_SECRET
MPESA_SHORTCODE=YOUR_PAYBILL_SHORTCODE
MPESA_TILL_NUMBER=YOUR_TILL_NUMBER
MPESA_PASSKEY=YOUR_PRODUCTION_PASSKEY
MPESA_CALLBACK_URL=https://api.yourdomain.com/api/v1/payments/mpesa/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPESA_CALLBACK_TOKEN=REPLACE_WITH_32_CHAR_RANDOM_HEX
MPESA_INITIATOR_NAME=YOUR_INITIATOR_NAME
MPESA_INITIATOR_PASSWORD=YOUR_INITIATOR_PASSWORD
MPESA_PARTY_A=YOUR_SHORTCODE
MPESA_PARTY_B=YOUR_SHORTCODE
# Optional: Lock callbacks to Safaricom IP range
MPESA_CALLBACK_IP_ALLOWLIST=196.201.214.200,196.201.214.206,196.201.213.114,196.201.214.207,196.201.214.208,196.201.213.44,196.201.212.127,196.201.212.138,196.201.212.129,196.201.212.136,196.201.212.74,196.201.212.69
MPESA_CALLBACK_SIGNATURE_SECRET=REPLACE_WITH_RANDOM_SECRET

# ── Stripe (PRODUCTION) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_PRODUCTION_WEBHOOK_SECRET

# ── PayPal (PRODUCTION) ───────────────────────────────────────
PAYPAL_CLIENT_ID=YOUR_PRODUCTION_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PRODUCTION_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=YOUR_PRODUCTION_WEBHOOK_ID
PAYPAL_ENV=live

# ── eTIMS (KRA — PRODUCTION) ──────────────────────────────────
ETIMS_BASE_URL=https://etims-api.kra.go.ke/etims-api
ETIMS_SANDBOX_URL=https://etims-sbx-api.kra.go.ke/etims-api
ETIMS_SELLER_PIN=YOUR_KRA_PIN           # Register via iTax portal
ETIMS_DEVICE_SERIAL=YOUR_VSCU_SERIAL   # From VSCU registration on iTax
ETIMS_ENV=production
