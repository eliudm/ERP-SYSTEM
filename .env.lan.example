# ── LAN Server Setup ─────────────────────────────────────────
# Copy this file to .env.lan and fill in your server's local IP.
# Find your server IP: run `ipconfig` (Windows) or `ip a` (Linux/Mac)

NODE_ENV=production
PORT=3000

# Replace with your server machine's local IP address
APP_URL=http://192.168.1.100
BACKEND_URL=http://192.168.1.100
CORS_ORIGIN=http://192.168.1.100

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://erpuser:erppassword@localhost:5432/erpdb

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT ──────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_DAYS=30

# ── Payments (leave as-is if not using) ──────────────────────
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_TILL_NUMBER=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://192.168.1.100/api/v1/payments/mpesa/callback
MPESA_CALLBACK_TOKEN=
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_PARTY_A=
MPESA_PARTY_B=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# ── eTIMS ────────────────────────────────────────────────────
ETIMS_BASE_URL=https://etims-api.kra.go.ke/etims-api
ETIMS_SANDBOX_URL=https://etims-sbx-api.kra.go.ke/etims-api
ETIMS_SELLER_PIN=
ETIMS_DEVICE_SERIAL=
ETIMS_ENV=sandbox
