generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// TENANTS (multi-company isolation)
// ============================================

// A Tenant is one subscribing company. Every row in a tenant-scoped model
// (see TENANT_SCOPED_MODELS in tenant-scoping.extension.ts) carries a
// tenantId and is transparently filtered/stamped with it by PrismaService —
// see tenant-context.ts for how the current request's tenantId is tracked.
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  branches       Branch[]
  customers      Customer[]
  salesInvoices  SalesInvoice[]
  accounts       Account[]
  journalEntries JournalEntry[]
  products       Product[]
  warehouses     Warehouse[]
  stockMovements StockMovement[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  employees      Employee[]
  payrolls       Payroll[]

  // Phase 2
  accountingPeriods         AccountingPeriod[]
  bankAccounts              BankAccount[]
  bankStatements            BankStatement[]
  taxRates                  TaxRate[]
  taxGroups                 TaxGroup[]
  auditLogs                 AuditLog[]
  notifications             Notification[]
  systemSettings            SystemSetting[]
  approvalRequests          ApprovalRequest[]
  salesQuotes               SalesQuote[]
  creditNotes               CreditNote[]
  priceLists                PriceList[]
  recurringInvoiceTemplates RecurringInvoiceTemplate[]
  productCategories         ProductCategory[]
  lots                      Lot[]
  serialNumbers             SerialNumber[]
  landedCosts               LandedCost[]
  stockCounts               StockCount[]
  stockTransfers            StockTransfer[]
  reorderRules              ReorderRule[]
  requestsForQuotation      RequestForQuotation[]
  vendorBills               VendorBill[]
  purchaseReturns           PurchaseReturn[]
  leaveRequests             LeaveRequest[]
  attendanceRecords         AttendanceRecord[]
  jobPostings               JobPosting[]
  jobApplications           JobApplication[]
  appraisals                Appraisal[]
  allowances                Allowance[]
  loanDeductions            LoanDeduction[]
  contacts                  Contact[]
  crmLeads                  CrmLead[]
  budgets                   Budget[]
  billsOfMaterial           BillOfMaterial[]
  workOrders                WorkOrder[]
  posSessions               PosSession[]

  @@map("tenants")
}

// ============================================
// AUTH & USERS
// ============================================

enum Role {
  ADMIN
  ACCOUNTANT
  SALES_USER
  INVENTORY_MANAGER
  HR_MANAGER
  PROCUREMENT_OFFICER
}

model User {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  email         String         @unique
  password      String
  pin           String?
  firstName     String
  lastName      String
  role          Role           @default(SALES_USER)
  posOnly       Boolean        @default(false)
  isActive      Boolean        @default(true)
  // The cashier's assigned outlet/till — drives "Point of Sale" on sales
  // made during their shifts, independent of which warehouse the sale is
  // later fulfilled from.
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  cashierSales  SalesInvoice[] @relation("InvoiceCashier")
  posSessions   PosSession[]

  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================
// ACCOUNTING
// ============================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

model Account {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  code         String
  name         String
  type         AccountType
  parentId     String?
  parent       Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountTree")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  journalLines JournalLine[]
  bankAccounts BankAccount[]
  taxRates     TaxRate[]
  budgetLines  BudgetLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@map("accounts")
}

model JournalEntry {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  reference    String
  description  String?
  entryDate    DateTime
  currency     String        @default("KES")
  exchangeRate Decimal       @default(1) @db.Decimal(18, 6)
  status       JournalStatus @default(DRAFT)
  sourceType   String? // e.g. "SALES_INVOICE", "PAYMENT"
  sourceId     String? // ID of the source document
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lines        JournalLine[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([entryDate])
  @@index([status])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model CurrencyRate {
  id            String   @id @default(uuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal  @db.Decimal(18, 6)
  rateDate      DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([baseCurrency, quoteCurrency, rateDate])
  @@index([baseCurrency, quoteCurrency, rateDate])
  @@map("currency_rates")
}

model JournalLine {
  id                 String              @id @default(uuid())
  journalEntryId     String
  journalEntry       JournalEntry        @relation(fields: [journalEntryId], references: [id])
  accountId          String
  account            Account             @relation(fields: [accountId], references: [id])
  debit              Decimal             @default(0) @db.Decimal(18, 2)
  credit             Decimal             @default(0) @db.Decimal(18, 2)
  description        String?
  createdAt          DateTime            @default(now())
  bankStatementLines BankStatementLine[]

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model AccountingPeriod {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  startDate DateTime
  endDate   DateTime
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("accounting_periods")
}

// ============================================
// SALES
// ============================================

enum InvoiceStatus {
  DRAFT
  APPROVED
  SENT
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
  CREDIT
}

model Customer {
  id                        String                     @id @default(uuid())
  tenantId                  String
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  name                      String
  email                     String?
  phone                     String?
  address                   String?
  taxPin                    String? // KRA PIN
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  invoices                  SalesInvoice[]
  quotes                    SalesQuote[]
  creditNotes               CreditNote[]
  recurringInvoiceTemplates RecurringInvoiceTemplate[]

  @@index([tenantId])
  @@map("customers")
}

model SalesInvoice {
  id                String                @id @default(uuid())
  tenantId          String
  tenant            Tenant                @relation(fields: [tenantId], references: [id])
  invoiceNo         String
  customerId        String
  customer          Customer              @relation(fields: [customerId], references: [id])
  branchId          String?
  branch            Branch?               @relation(fields: [branchId], references: [id])
  invoiceDate       DateTime
  dueDate           DateTime?
  status            InvoiceStatus         @default(DRAFT)
  subtotal          Decimal               @db.Decimal(18, 2)
  taxAmount         Decimal               @db.Decimal(18, 2)
  total             Decimal               @db.Decimal(18, 2)
  paymentMethod     PaymentMethod?
  paidAt            DateTime?
  // Cost of goods sold at the moment this invoice was approved — computed
  // once from each line's product.costPrice and stored here so later profit
  // reporting reflects what was actually posted to the GL, not whatever a
  // product's cost happens to be today. Null until approved (or for
  // invoices approved before this field existed, until backfilled).
  cogsAmount        Decimal?              @db.Decimal(18, 2)
  notes             String?
  // Client-generated reference (e.g. the mobile app's offline-queue id) used
  // to make retrying POST /sales/invoices idempotent — see InvoicesService.create().
  // Nullable: every non-offline caller (web, API integrations) never sets it,
  // and Postgres treats multiple NULLs as distinct under a unique index.
  clientRef         String?
  // Who processed the sale and which POS session it fell within — both
  // nullable since non-POS (Sales module) invoices have neither.
  cashierId         String?
  cashier           User?                 @relation("InvoiceCashier", fields: [cashierId], references: [id])
  posSessionId      String?
  posSession        PosSession?           @relation(fields: [posSessionId], references: [id])
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  items             SalesInvoiceItem[]
  mpesaTransactions MpesaTransaction[]
  etimsInvoice      EtimsInvoice?
  quotes            SalesQuote[]
  creditNotes       CreditNote[]
  recurringRuns     RecurringInvoiceRun[]
  notifications     Notification[]

  @@unique([tenantId, invoiceNo])
  @@unique([tenantId, clientRef])
  @@index([tenantId])
  @@index([customerId])
  @@index([branchId])
  @@index([cashierId])
  @@index([posSessionId])
  @@index([status])
  @@index([invoiceDate])
  @@map("sales_invoices")
}

// A POS cash-register working period: opened by a cashier, sales happen
// within it, closed with a reconciliation note/cash count. Nullable links
// everywhere since plenty of invoices (Sales module, pre-dating this
// feature) have no session.
model PosSession {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  sessionRef    String // e.g. "MAIN/00001" — branch code (or "POS") + sequential number
  cashierId     String
  cashier       User           @relation(fields: [cashierId], references: [id])
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id])
  status        String         @default("OPEN") // OPEN | CLOSED
  openedAt      DateTime       @default(now())
  closedAt      DateTime?
  closingNote   String?
  closingCounts Json?
  invoices      SalesInvoice[]

  @@index([tenantId])
  @@index([cashierId])
  @@index([status])
  @@map("pos_sessions")
}

enum MpesaTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model MpesaTransaction {
  id                String                 @id @default(uuid())
  invoiceId         String
  invoice           SalesInvoice           @relation(fields: [invoiceId], references: [id])
  phoneNumber       String
  amount            Decimal                @db.Decimal(18, 2)
  merchantRequestId String?
  checkoutRequestId String?                @unique
  resultCode        Int?
  resultDesc        String?
  receiptNumber     String?
  transactionDate   DateTime?
  status            MpesaTransactionStatus @default(PENDING)
  callbackPayload   Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([invoiceId, status])
  @@map("mpesa_transactions")
}

model SalesInvoiceItem {
  id          String       @id @default(uuid())
  invoiceId   String
  invoice     SalesInvoice @relation(fields: [invoiceId], references: [id])
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  description String?
  quantity    Decimal      @db.Decimal(18, 2)
  unitPrice   Decimal      @db.Decimal(18, 2)
  taxRate     Decimal      @db.Decimal(5, 2)
  taxAmount   Decimal      @db.Decimal(18, 2)
  lineTotal   Decimal      @db.Decimal(18, 2)
  createdAt   DateTime     @default(now())

  @@index([invoiceId])
  @@index([productId])
  @@map("sales_invoice_items")
}

// ============================================
// INVENTORY
// ============================================

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model Warehouse {
  id             String          @id @default(uuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  name           String
  code           String?
  branchId       String?
  branch         Branch?         @relation(fields: [branchId], references: [id])
  location       String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  stockMovements StockMovement[]
  stockCounts    StockCount[]
  serialNumbers  SerialNumber[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([branchId])
  @@map("warehouses")
}

model Branch {
  id                        String                     @id @default(uuid())
  tenantId                  String
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  name                      String
  code                      String
  location                  String?
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  warehouses                Warehouse[]
  invoices                  SalesInvoice[]
  recurringInvoiceTemplates RecurringInvoiceTemplate[]
  posSessions               PosSession[]
  users                     User[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model ProductCategory {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  color     String? // hex color e.g. "#1677ff"
  icon      String? // emoji e.g. "\uD83E\uDE91"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id                     String                         @id @default(uuid())
  tenantId               String
  tenant                 Tenant                         @relation(fields: [tenantId], references: [id])
  code                   String
  barcode                String?
  name                   String
  description            String?
  categoryId             String?
  category               ProductCategory?               @relation(fields: [categoryId], references: [id])
  unitPrice              Decimal                        @db.Decimal(18, 2)
  taxRate                Decimal                        @default(0.16) @db.Decimal(5, 2)
  costPrice              Decimal?                       @db.Decimal(18, 2)
  costPriceIncludesVat   Boolean                        @default(true)
  stockQuantity          Decimal                        @default(0) @db.Decimal(18, 2)
  reorderLevel           Decimal                        @default(0) @db.Decimal(18, 2)
  isActive               Boolean                        @default(true)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  stockMovements         StockMovement[]
  invoiceItems           SalesInvoiceItem[]
  procurementItems       ProcurementItem[]
  quoteItems             SalesQuoteItem[]
  creditNoteItems        CreditNoteItem[]
  priceListItems         PriceListItem[]
  lots                   Lot[]
  serialNumbers          SerialNumber[]
  variants               ProductVariant[]
  landedCostItems        LandedCostItem[]
  stockCountLines        StockCountLine[]
  transferLines          StockTransferLine[]
  rfqItems               RFQItem[]
  vendorBillItems        VendorBillItem[]
  purchaseReturnItems    PurchaseReturnItem[]
  recurringTemplateItems RecurringInvoiceTemplateItem[]
  reorderRules           ReorderRule[]
  bomProducts            BillOfMaterial[]               @relation("BOMProduct")
  bomComponents          BOMLine[]                      @relation("BOMComponent")

  @@unique([tenantId, code])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model StockMovement {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  warehouseId  String
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  movementType MovementType
  quantity     Decimal      @db.Decimal(18, 2)
  unitCost     Decimal?     @db.Decimal(18, 2)
  reference    String?
  notes        String?
  lotId        String?
  lot          Lot?         @relation(fields: [lotId], references: [id])
  createdAt    DateTime     @default(now())

  @@index([tenantId])
  @@index([productId])
  @@index([warehouseId])
  @@index([lotId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ============================================
// PROCUREMENT
// ============================================

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  RECEIVED
  VOID
}

model Supplier {
  id              String                @id @default(uuid())
  tenantId        String
  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  name            String
  email           String?
  phone           String?
  address         String?
  taxPin          String?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  purchaseOrders  PurchaseOrder[]
  rfqs            RequestForQuotation[]
  vendorBills     VendorBill[]
  purchaseReturns PurchaseReturn[]
  reorderRules    ReorderRule[]

  @@index([tenantId])
  @@map("suppliers")
}

model PurchaseOrder {
  id              String               @id @default(uuid())
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  orderNo         String
  supplierId      String
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  rfqId           String?              @unique
  rfq             RequestForQuotation? @relation(fields: [rfqId], references: [id])
  orderDate       DateTime
  status          PurchaseOrderStatus  @default(DRAFT)
  subtotal        Decimal              @db.Decimal(18, 2)
  taxAmount       Decimal              @db.Decimal(18, 2)
  total           Decimal              @db.Decimal(18, 2)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  items           ProcurementItem[]
  landedCosts     LandedCost[]
  vendorBills     VendorBill[]
  purchaseReturns PurchaseReturn[]

  @@unique([tenantId, orderNo])
  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

model ProcurementItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(18, 2)
  unitCost        Decimal       @db.Decimal(18, 2)
  taxRate         Decimal       @db.Decimal(5, 2)
  taxAmount       Decimal       @db.Decimal(18, 2)
  lineTotal       Decimal       @db.Decimal(18, 2)
  isTaxInclusive  Boolean       @default(true)
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("procurement_items")
}

// ============================================
// ETIMS
// ============================================

enum EtimsStatus {
  PENDING
  SUBMITTED
  SUCCESS
  FAILED
}

model EtimsInvoice {
  id             String               @id @default(uuid())
  invoiceId      String               @unique
  invoice        SalesInvoice         @relation(fields: [invoiceId], references: [id])
  status         EtimsStatus          @default(PENDING)
  qrCode         String?
  etimsInvoiceNo String?
  submittedAt    DateTime?
  responseData   Json?
  retryCount     Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  submissionLogs EtimsSubmissionLog[]

  @@map("etims_invoices")
}

// ============================================
// HR
// ============================================

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

model Employee {
  id                String             @id @default(uuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  employeeNo        String
  firstName         String
  lastName          String
  email             String
  phone             String?
  department        String?
  position          String?
  salary            Decimal            @db.Decimal(18, 2)
  startDate         DateTime
  status            EmployeeStatus     @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  payrollLines      PayrollLine[]
  leaveRequests     LeaveRequest[]
  attendanceRecords AttendanceRecord[]
  appraisals        Appraisal[]
  allowances        Allowance[]
  loanDeductions    LoanDeduction[]

  @@unique([tenantId, employeeNo])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([status])
  @@index([department])
  @@map("employees")
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
}

model Payroll {
  id         String        @id @default(uuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  month      Int
  year       Int
  status     PayrollStatus @default(DRAFT)
  totalGross Decimal       @db.Decimal(18, 2)
  totalPaye  Decimal       @db.Decimal(18, 2)
  totalNhif  Decimal       @db.Decimal(18, 2)
  totalNssf  Decimal       @db.Decimal(18, 2)
  totalNet   Decimal       @db.Decimal(18, 2)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  lines      PayrollLine[]

  @@unique([tenantId, month, year])
  @@index([tenantId])
  @@map("payrolls")
}

model PayrollLine {
  id                     String   @id @default(uuid())
  payrollId              String
  payroll                Payroll  @relation(fields: [payrollId], references: [id])
  employeeId             String
  employee               Employee @relation(fields: [employeeId], references: [id])
  grossSalary            Decimal  @db.Decimal(18, 2)
  payeAmount             Decimal  @db.Decimal(18, 2)
  nhifAmount             Decimal  @db.Decimal(18, 2)
  nssfAmount             Decimal  @db.Decimal(18, 2)
  totalAllowances        Decimal  @default(0) @db.Decimal(18, 2)
  totalLoanDeductions    Decimal  @default(0) @db.Decimal(18, 2)
  netSalary              Decimal  @db.Decimal(18, 2)
  allowancesSnapshot     Json?
  loanDeductionsSnapshot Json?
  createdAt              DateTime @default(now())

  @@index([payrollId])
  @@index([employeeId])
  @@map("payroll_lines")
}

model LeaveRequest {
  id         String      @id @default(uuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id])
  leaveType  LeaveType
  startDate  DateTime
  endDate    DateTime
  days       Int
  reason     String?
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

// ============================================
// SYSTEM SETTINGS
// ============================================

model SystemSetting {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  key                 String   @default("system")
  companyName         String
  companyLogo         String?  @db.Text
  companyPin          String?
  companyAddress      String?
  companyPhone        String?
  paymentInstructions String?  @db.Text
  receiptSlogan       String?
  invoiceTemplate     String   @default("modern")
  receiptTemplate     String   @default("standard")
  defaultCurrency     String   @default("KES")
  timezone            String   @default("Africa/Nairobi")
  defaultLanguage     String   @default("en-KE")
  emailNotifications  Boolean  @default(true)
  autoApproveDrafts   Boolean  @default(false)
  showLowStockAlerts  Boolean  @default(true)
  lowStockThreshold   Int      @default(5)
  posReceiptBranding  Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("system_settings")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  action    String
  tableName String
  recordId  String?
  oldValues Json?
