  updatedAt       DateTime             @updatedAt
  items           PurchaseReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String         @id @default(uuid())
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  quantity         Decimal        @db.Decimal(18, 2)
  unitCost         Decimal        @db.Decimal(18, 2)
  lineTotal        Decimal        @db.Decimal(18, 2)
  createdAt        DateTime       @default(now())

  @@index([purchaseReturnId])
  @@index([productId])
  @@map("purchase_return_items")
}

// ============================================
// HR — ATTENDANCE, RECRUITMENT, APPRAISALS
// ============================================

enum AttendanceType {
  REGULAR
  OVERTIME
}

enum JobPostingStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  RECEIVED
  SHORTLISTED
  INTERVIEWED
  OFFERED
  HIRED
  REJECTED
}

enum InterviewResult {
  PENDING
  PASS
  FAIL
}

enum AppraisalStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum AllowanceType {
  HOUSING
  TRANSPORT
  MEDICAL
  OTHER
}

model AttendanceRecord {
  id           String         @id @default(uuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id])
  clockIn      DateTime
  clockOut     DateTime?
  durationMins Int?
  type         AttendanceType @default(REGULAR)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([clockIn])
  @@map("attendance_records")
}

model JobPosting {
  id           String           @id @default(uuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  title        String
  department   String?
  description  String?
  requirements String?
  status       JobPostingStatus @default(OPEN)
  closingDate  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]

  @@index([tenantId])
  @@map("job_postings")
}

model JobApplication {
  id            String            @id @default(uuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  jobPostingId  String
  jobPosting    JobPosting        @relation(fields: [jobPostingId], references: [id])
  applicantName String
  email         String
  phone         String?
  cvUrl         String?
  coverLetter   String?
  status        ApplicationStatus @default(RECEIVED)
  hiredAs       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  interviews    Interview[]

  @@index([tenantId])
  @@index([jobPostingId])
  @@index([status])
  @@map("job_applications")
}

model Interview {
  id               String          @id @default(uuid())
  jobApplicationId String
  jobApplication   JobApplication  @relation(fields: [jobApplicationId], references: [id])
  scheduledAt      DateTime
  interviewerId    String
  location         String?
  notes            String?
  feedback         String?
  result           InterviewResult @default(PENDING)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([jobApplicationId])
  @@map("interviews")
}

model Appraisal {
  id           String          @id @default(uuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  employeeId   String
  employee     Employee        @relation(fields: [employeeId], references: [id])
  reviewerId   String
  period       String
  status       AppraisalStatus @default(DRAFT)
  overallScore Decimal?        @db.Decimal(4, 2)
  comments     String?
  submittedAt  DateTime?
  approvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  items        AppraisalItem[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@map("appraisals")
}

model AppraisalItem {
  id          String    @id @default(uuid())
  appraisalId String
  appraisal   Appraisal @relation(fields: [appraisalId], references: [id])
  criteria    String
  target      String?
  achievement String?
  score       Decimal?  @db.Decimal(4, 2)
  weight      Decimal   @default(1) @db.Decimal(4, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([appraisalId])
  @@map("appraisal_items")
}

model Allowance {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id])
  type        AllowanceType
  amount      Decimal       @db.Decimal(18, 2)
  isRecurring Boolean       @default(true)
  isActive    Boolean       @default(true)
  startDate   DateTime
  endDate     DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([isActive])
  @@map("allowances")
}

model LoanDeduction {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  description      String?
  totalAmount      Decimal  @db.Decimal(18, 2)
  monthlyDeduction Decimal  @db.Decimal(18, 2)
  balance          Decimal  @db.Decimal(18, 2)
  startDate        DateTime
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([isActive])
  @@map("loan_deductions")
}

// ============================================
// REORDER RULES
// ============================================

model ReorderRule {
  id                  String    @id @default(uuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  productId           String
  product             Product   @relation(fields: [productId], references: [id])
  preferredSupplierId String?
  preferredSupplier   Supplier? @relation(fields: [preferredSupplierId], references: [id])
  reorderPoint        Decimal   @db.Decimal(18, 2) // trigger when stock <= this
  reorderQty          Decimal   @db.Decimal(18, 2) // suggested qty to order
  maxStock            Decimal?  @db.Decimal(18, 2) // optional max stock level
  isAutomatic         Boolean   @default(false) // auto-create PO suggestion
  isActive            Boolean   @default(true)
  lastTriggeredAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([productId])
  @@index([tenantId])
  @@map("reorder_rules")
}

// ============================================
// BUDGET
// ============================================

enum BudgetStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model Budget {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  name        String
  fiscalYear  Int
  startDate   DateTime
  endDate     DateTime
  status      BudgetStatus @default(DRAFT)
  notes       String?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lines       BudgetLine[]

  @@unique([tenantId, fiscalYear, name])
  @@index([tenantId])
  @@map("budgets")
}

model BudgetLine {
  id        String   @id @default(uuid())
  budgetId  String
  budget    Budget   @relation(fields: [budgetId], references: [id])
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  month     Int // 1-12
  amount    Decimal  @db.Decimal(18, 2)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([budgetId, accountId, month])
  @@index([accountId])
  @@map("budget_lines")
}

// ============================================
// MANUFACTURING (MRP)
// ============================================

enum BOMStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkOrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
}

model BillOfMaterial {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  name        String
  productId   String
  product     Product     @relation("BOMProduct", fields: [productId], references: [id])
  quantity    Decimal     @default(1) @db.Decimal(18, 2) // output qty per run
  status      BOMStatus   @default(DRAFT)
  notes       String?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lines       BOMLine[]
  workOrders  WorkOrder[]

  @@index([tenantId])
  @@index([productId])
  @@index([status])
  @@map("bills_of_material")
}

model BOMLine {
  id        String         @id @default(uuid())
  bomId     String
  bom       BillOfMaterial @relation(fields: [bomId], references: [id])
  productId String
  product   Product        @relation("BOMComponent", fields: [productId], references: [id])
  quantity  Decimal        @db.Decimal(18, 2) // qty per 1 unit of finished product
  notes     String?
  createdAt DateTime       @default(now())

  @@unique([bomId, productId])
  @@index([productId])
  @@map("bom_lines")
}

model WorkOrder {
  id             String          @id @default(uuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  reference      String
  bomId          String
  bom            BillOfMaterial  @relation(fields: [bomId], references: [id])
  quantity       Decimal         @db.Decimal(18, 2) // how many units to produce
  status         WorkOrderStatus @default(DRAFT)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([bomId])
  @@index([status])
  @@map("work_orders")
}

// ============================================
// PLUGIN SYSTEM
// ============================================

enum PluginStatus {
  ACTIVE
  INACTIVE
  ERROR
}

model Plugin {
  id          String       @id @default(uuid())
  name        String       @unique
  version     String
  description String?
  author      String?
  entryPoint  String // module path or class name
  config      Json? // plugin-specific configuration
  status      PluginStatus @default(INACTIVE)
  installedAt DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("plugins")
}

// ============================================
// FEATURE FLAGS
// ============================================

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}
